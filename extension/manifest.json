{
  "manifest_version": 3,
  "name": "AI 聊天记录导出",
  "version": "1.2.0",
  "description": "一键抓取 ChatGPT / Claude / Gemini / Grok 的聊天记录，支持筛选并导出 JSON / Markdown / TXT / HTML / PDF（高质量 PDF 可配合本地 export.js）",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 聊天记录导出"
  }
}
