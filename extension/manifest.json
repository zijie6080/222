{
  "manifest_version": 3,
  "name": "AI 聊天记录导出",
  "version": "1.5.2",
  "description": "Export your ChatGPT, Claude, Gemini, Grok, DeepSeek, Kimi & more AI chats to PDF/Markdown/HTML/JSON/TXT. 100% local.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://chatglm.cn/*",
    "https://www.doubao.com/*",
    "https://yuanbao.tencent.com/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 聊天记录导出",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
