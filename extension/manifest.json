{
  "manifest_version": 3,
  "name": "AI 聊天记录导出",
  "version": "1.1.0",
  "description": "一键抓取 ChatGPT / Claude / Gemini / Grok 的聊天记录，支持筛选并导出 JSON / Markdown / TXT / HTML（配合本地 export.js 生成高质量 PDF）",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 聊天记录导出"
  }
}
